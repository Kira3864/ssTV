<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/appBg">
  <FrameLayout android:id="@+id/videoStage" android:layout_width="match_parent" android:layout_height="220dp" android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit" app:show_buffering="when_playing" />
    <View android:id="@+id/videoGestures" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="false" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/videoControls" android:layout_width="match_parent" android:layout_height="match_parent">
      <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="top" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@drawable/bg_video_top">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_back" android:contentDescription="返回" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="6dp" />
        <ImageButton android:id="@+id/btnCast" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_cast" android:contentDescription="投屏" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
<ImageButton android:id="@+id/btnFavorite" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_favorite" android:contentDescription="收藏" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" /><ImageButton android:id="@+id/btnLike" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_like" android:contentDescription="喜欢此刻" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
        <ImageButton android:id="@+id/btnCache" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_download" android:contentDescription="缓存" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bottomControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingTop="8dp" android:background="@drawable/bg_video_bottom">
        <SeekBar android:id="@+id/playerSeek" android:layout_width="match_parent" android:layout_height="24dp" android:paddingHorizontal="10dp" android:max="1000" android:progressTint="?attr/appAccent" android:thumbTint="#FFFFFF" android:contentDescription="播放进度" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageButton android:id="@+id/btnPlayPause" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_play" android:contentDescription="播放" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
          <ImageButton android:id="@+id/btnNext" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_next" android:contentDescription="下一集" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
          <TextView android:id="@+id/playerTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00 / 00:00" android:textSize="10sp" android:textColor="#FFFFFF" android:maxLines="1" android:gravity="center_vertical" />
          <TextView android:id="@+id/btnEp" android:layout_width="40dp" android:layout_height="40dp" android:text="选集" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" android:background="@drawable/bg_video_button" />
          <TextView android:id="@+id/btnQuality" android:layout_width="44dp" android:layout_height="40dp" android:text="自动" android:contentDescription="清晰度" android:textSize="11sp" android:textColor="#FFFFFF" android:gravity="center" android:background="@drawable/bg_video_button" />
          <TextView android:id="@+id/btnSpeed" android:layout_width="40dp" android:layout_height="40dp" android:text="1×" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" android:background="@drawable/bg_video_button" />
          <ImageButton android:id="@+id/btnFull" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_player_fullscreen" android:contentDescription="全屏" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>
    <ImageButton android:id="@+id/btnLock" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_player_unlock" android:contentDescription="锁定屏幕" android:background="@drawable/bg_video_button" app:tint="#FFFFFF" android:layout_gravity="center_vertical|start" android:layout_marginStart="12dp" />
    <FrameLayout android:id="@+id/speedPanel" android:layout_width="304dp" android:layout_height="88dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginHorizontal="12dp" android:layout_marginBottom="76dp" android:background="@drawable/bg_speed_ruler" android:elevation="6dp" android:visibility="gone">
      <com.songshu.sstv.ui.PlaybackSpeedSlider android:id="@+id/speedSlider" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
    <LinearLayout android:id="@+id/hudBox" android:layout_width="150dp" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="16dp" android:background="@drawable/bg_video_sheet" android:visibility="gone">
      <TextView android:id="@+id/hudLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
      <TextView android:id="@+id/hudValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="21sp" android:gravity="center" android:layout_marginTop="6dp" />
    </LinearLayout>
  </FrameLayout>
  <ScrollView android:id="@+id/playerDetails" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
      <TextView android:id="@+id/watchTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="21sp" android:textColor="?attr/appText" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:textStyle="bold" />
      <TextView android:id="@+id/watchMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="?attr/appText" android:gravity="center_vertical" android:layout_marginBottom="12dp" />
      <TextView android:id="@+id/playerSource" android:layout_width="match_parent" android:layout_height="42dp" android:text="切换片源  ▾" android:textSize="14sp" android:textColor="?attr/appAccent" android:gravity="center" android:layout_marginBottom="12dp" android:background="@drawable/bg_btn_ghost" />
      <LinearLayout android:id="@+id/watchLines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
      <TextView android:id="@+id/watchEpisodeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选集" android:textSize="16sp" android:textColor="?attr/appText" android:gravity="center_vertical" android:layout_marginBottom="12dp" />
      <LinearLayout android:id="@+id/watchEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
      <TextView android:id="@+id/watchPlot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="?attr/appText" android:gravity="center_vertical" android:layout_marginBottom="12dp" />
<TextView android:id="@+id/btnClearPlayback" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:gravity="center" android:background="@drawable/bg_btn_ghost" android:text="清空" android:textStyle="bold" android:textColor="?attr/appAccent" android:textSize="15sp" />
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:id="@+id/emptyPlayback" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="32dp">
    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_play" app:tint="?attr/appTextMuted" android:contentDescription="@null" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="当前没有正在播放的内容" android:gravity="center" android:textSize="16sp" android:textColor="?attr/appText" />
    <TextView android:id="@+id/watchFind" android:layout_width="120dp" android:layout_height="42dp" android:layout_marginTop="24dp" android:text="找片" android:gravity="center" android:textSize="14sp" android:textColor="?attr/appOnAccent" android:background="@drawable/bg_btn_primary" />
  </LinearLayout>
  <com.songshu.sstv.ui.BottomNav android:id="@+id/playerNavigation" android:layout_width="match_parent" android:layout_height="56dp" />
</LinearLayout>
