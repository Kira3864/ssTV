<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_page" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <TextView android:id="@+id/btnBack" android:layout_width="56dp" android:layout_height="48dp" android:text="返回" android:textSize="14sp" android:textColor="?attr/appTextMuted" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="设置" android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/appText" />
    </LinearLayout>
    <ScrollView android:id="@+id/settingsScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/settingsContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
            <TextView style="@style/SettingsSection" android:text="播放" />
            <LinearLayout style="@style/SettingsCard">
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swRestorePlayback" style="@style/SettingsSwitch" android:text="保留上次播放内容" />
                <View style="@style/SettingsDivider" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swAutoCache" style="@style/SettingsSwitch" android:text="边看边缓存" />
            </LinearLayout>
            <TextView style="@style/SettingsSection" android:text="外观" />
            <LinearLayout style="@style/SettingsCard">
                <LinearLayout android:id="@+id/btnTheme" style="@style/SettingsRow">
                    <TextView style="@style/SettingsLabel" android:text="主题风格" />
                    <TextView android:id="@+id/themeValue" style="@style/SettingsValue" />
                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swReduceMotion" style="@style/SettingsSwitch" android:text="减少动画" />
            </LinearLayout>
            <TextView style="@style/SettingsSection" android:text="片源与内容" />
            <LinearLayout style="@style/SettingsCard">
                <LinearLayout android:id="@+id/btnManageSources" style="@style/SettingsRow">
                    <TextView style="@style/SettingsLabel" android:text="片源管理" />
                    <TextView android:id="@+id/sourceSummary" style="@style/SettingsValue" />
                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swFilterAdult" style="@style/SettingsSwitch" android:text="NSFW" />
            </LinearLayout>
            <TextView style="@style/SettingsSection" android:text="缓存与存储" />
            <LinearLayout style="@style/SettingsCard">
                <LinearLayout android:id="@+id/btnOverlay" style="@style/SettingsRow">
                    <TextView style="@style/SettingsLabel" android:text="缓存悬浮窗" />
                    <TextView android:id="@+id/overlayValue" style="@style/SettingsValue" />
                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/btnClearCache" style="@style/SettingsRow">
                    <TextView style="@style/SettingsLabel" android:text="清理在线播放缓存" />
                    <TextView android:id="@+id/cacheInfo" style="@style/SettingsValue" />
                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/btnDownloads" style="@style/SettingsRow">
                    <TextView style="@style/SettingsLabel" android:text="已缓存视频" />
                    <TextView android:id="@+id/downloadSize" style="@style/SettingsValue" />
                    <TextView style="@style/SettingsChevron" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/SettingsSection" android:text="关于" />
            <LinearLayout style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsRow">
                    <TextView style="@style/SettingsLabel" android:text="当前版本" />
                    <TextView android:id="@+id/about" style="@style/SettingsValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
